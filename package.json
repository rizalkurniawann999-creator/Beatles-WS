{
  "name": "beatles-ws",
  "version": "1.0.0",
  "private": true,
  "description": "Beatles-WS full-stack WhatsApp management platform",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "check": "node --check src/server.js && node --check src/routes/api.js && node --check src/routes/whatsapp/client.js && node --check src/routes/whatsapp/pairing-limit.js",
    "test": "node test/pairing-limit.test.js && node test/server-safety.test.js",
    "test:e2e": "bash test/api.e2e.sh",
    "cf:install": "bash cloudflare/scripts/install-cloudflared.sh",
    "cf:status": "bash cloudflare/scripts/status.sh",
    "tunnel:quick": "bash cloudflare/scripts/quick-tunnel.sh",
    "serve:public": "bash cloudflare/scripts/serve-public.sh",
    "tunnel:start": "bash cloudflare/scripts/tunnel-token.sh",
    "deploy:pages": "bash cloudflare/scripts/deploy-pages.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "qrcode": "^1.5.4"
  }
}
