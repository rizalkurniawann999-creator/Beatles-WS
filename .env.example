# Konfigurasi Port Server
PORT=3000

# Kunci Rahasia JWT (Isi dengan string acak yang aman)
JWT_SECRET=ganti_dengan_secret_key_anda

# Konfigurasi CORS
CORS_ORIGIN=*

# --- Cloudflare (opsional, untuk deploy/tunnel) ---
# Jangan isi nilai asli di file contoh ini. Salin ke .env (sudah di-gitignore).
# API Token untuk deploy Pages / Wrangler:
CLOUDFLARE_API_TOKEN=
# Token named tunnel (Zero Trust -> Tunnels -> Install connector):
CLOUDFLARE_TUNNEL_TOKEN=
# Nama project Pages & branch (opsional, ada default):
CF_PAGES_PROJECT=beatles-ws
CF_PAGES_BRANCH=main
